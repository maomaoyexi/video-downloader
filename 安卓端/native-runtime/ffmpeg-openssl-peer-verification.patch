+int ff_http_copy_tls_verification_options(const URLContext *h, AVDictionary **options)
+{
+    const HTTPContext *s = h->priv_data;
+    const AVDictionaryEntry *entry = NULL;
+    int ret;
+
+    while ((entry = av_dict_iterate(s->chained_options, entry))) {
+        if (strcmp(entry->key, "tls_verify") &&
+            strcmp(entry->key, "ca_file") &&
+            strcmp(entry->key, "cafile"))
+            continue;
+        ret = av_dict_set(options, entry->key, entry->value, 0);
+        if (ret < 0)
+            return ret;
+    }
+
+    return 0;
+}
